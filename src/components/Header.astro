---
const email = "info@findpiattorney.com";
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/personal-injury-attorneys", label: "Browse Attorneys" },
  { href: "/when-to-hire-a-personal-injury-attorney", label: "When to Hire" },
  { href: "/contact", label: "Contact" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="bg-brand-900 text-white">
  <div class="page-container">
    <div class="hidden md:flex items-center justify-end gap-6 text-xs py-1.5 border-b border-brand-800">
      <a href={`mailto:${email}`} class="hover:text-brand-200 transition-colors flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        {email}
      </a>
    </div>

    <div class="flex items-center justify-between py-2">
      <a href="/" class="flex items-center gap-2.5">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
          <span class="text-lg font-bold leading-tight">
            PI Attorney<br/><span class="text-brand-300 font-normal text-sm">Directory</span>
          </span>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-1">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`px-3 py-2 text-sm font-medium transition-colors ${
              isActive(href)
                ? "text-white underline underline-offset-[6px] decoration-2 decoration-brand-300"
                : "text-gray-200 hover:bg-brand-800 hover:text-white rounded"
            }`}
            aria-current={isActive(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))}
      </nav>

      <button id="mobile-menu-btn" class="lg:hidden p-2 rounded text-white hover:bg-brand-800" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-brand-800">
    <div class="page-container py-4 space-y-1">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`block px-4 py-2 text-sm transition-colors ${
            isActive(href)
              ? "text-white font-semibold underline underline-offset-[6px] decoration-2 decoration-brand-300"
              : "text-gray-200 hover:bg-brand-700 hover:text-white rounded"
          }`}
          aria-current={isActive(href) ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
  }
</script>
