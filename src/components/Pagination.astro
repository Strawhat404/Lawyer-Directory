---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string; // e.g. /personal-injury-attorneys/florida/miami
}

const { currentPage, totalPages, baseUrl } = Astro.props;

function getPageUrl(page: number) {
  if (page === 1) return baseUrl;
  return `${baseUrl}/page/${page}`;
}

// Build visible page numbers (show 5 around current)
const delta = 2;
const rangeStart = Math.max(1, currentPage - delta);
const rangeEnd = Math.min(totalPages, currentPage + delta);
const pages: number[] = [];
for (let i = rangeStart; i <= rangeEnd; i++) pages.push(i);

const showStartEllipsis = rangeStart > 2;
const showEndEllipsis = rangeEnd < totalPages - 1;
---

{totalPages > 1 && (
  <nav aria-label="Pagination" class="mt-10 flex items-center justify-center gap-1 flex-wrap">
    <!-- Previous -->
    {currentPage > 1 ? (
      <a
        href={getPageUrl(currentPage - 1)}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm font-medium text-gray-600 hover:border-brand-400 hover:text-brand-700 transition-colors"
        aria-label="Previous page"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Prev
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-100 text-sm font-medium text-gray-300 cursor-not-allowed">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Prev
      </span>
    )}

    <!-- First page -->
    {rangeStart > 1 && (
      <a href={getPageUrl(1)} class={`w-9 h-9 flex items-center justify-center rounded-lg border text-sm font-medium transition-colors ${1 === currentPage ? 'bg-brand-700 border-brand-700 text-white' : 'border-gray-200 text-gray-600 hover:border-brand-400 hover:text-brand-700'}`}>1</a>
    )}
    {showStartEllipsis && <span class="w-9 h-9 flex items-center justify-center text-gray-400 text-sm">…</span>}

    <!-- Page range -->
    {pages.map(page => (
      <a
        href={getPageUrl(page)}
        aria-current={page === currentPage ? "page" : undefined}
        class={`w-9 h-9 flex items-center justify-center rounded-lg border text-sm font-medium transition-colors ${page === currentPage ? 'bg-brand-700 border-brand-700 text-white' : 'border-gray-200 text-gray-600 hover:border-brand-400 hover:text-brand-700'}`}
      >
        {page}
      </a>
    ))}

    <!-- Last page -->
    {showEndEllipsis && <span class="w-9 h-9 flex items-center justify-center text-gray-400 text-sm">…</span>}
    {rangeEnd < totalPages && (
      <a href={getPageUrl(totalPages)} class={`w-9 h-9 flex items-center justify-center rounded-lg border text-sm font-medium transition-colors ${totalPages === currentPage ? 'bg-brand-700 border-brand-700 text-white' : 'border-gray-200 text-gray-600 hover:border-brand-400 hover:text-brand-700'}`}>{totalPages}</a>
    )}

    <!-- Next -->
    {currentPage < totalPages ? (
      <a
        href={getPageUrl(currentPage + 1)}
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm font-medium text-gray-600 hover:border-brand-400 hover:text-brand-700 transition-colors"
        aria-label="Next page"
      >
        Next
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    ) : (
      <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-100 text-sm font-medium text-gray-300 cursor-not-allowed">
        Next
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    )}
  </nav>
)}
