---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Privacy Policy | Personal Injury Attorney Directory"
  description="Privacy policy for the Personal Injury Attorney Directory."
  canonical="https://www.findpiattorney.com/privacy-policy"
>
  <Header />
  <main class="flex-1">
    <section class="section-padding">
      <div class="page-container">
        <div class="max-w-3xl mx-auto prose prose-lg">
          <h1>Privacy Policy</h1>
          
          <p><strong>Last Updated:</strong> August 15, 2026</p>

          <h2>Overview</h2>
          <p>
            This privacy policy describes how Personal Injury Attorney Directory ("we", "us", "our") collects, uses, and shares information when you use our website.
          </p>

          <h2>Information We Collect</h2>
          <p>
            We collect information you provide directly to us, such as when you contact us via email. We also collect certain information automatically when you visit our website, including:
          </p>
          <ul>
            <li>Browser type and version</li>
            <li>Pages you visit on our site</li>
            <li>Time and date of your visit</li>
            <li>Referring website</li>
          </ul>

          <h2>How We Use Information</h2>
          <p>We use the information we collect to:</p>
          <ul>
            <li>Provide and maintain our directory service</li>
            <li>Respond to your inquiries and requests</li>
            <li>Improve our website and services</li>
            <li>Comply with legal obligations</li>
          </ul>

          <h2>Information Sharing</h2>
          <p>
            We do not sell or rent your personal information to third parties. We may share information in the following circumstances:
          </p>
          <ul>
            <li>With your consent</li>
            <li>To comply with legal obligations</li>
            <li>To protect our rights and property</li>
          </ul>

          <h2>Attorney Listings</h2>
          <p>
            Attorney information displayed on this website is derived from public records maintained by The Florida Bar. Attorneys listed may not have paid for placement or provided consent for inclusion.
          </p>

          <h2>Contact Us</h2>
          <p>
            If you have questions about this privacy policy, please contact us at:
            <a href="mailto:info@findpiattorney.com">info@findpiattorney.com</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
