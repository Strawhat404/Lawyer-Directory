---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AttorneyCard from "../../../components/AttorneyCard.astro";
import { getAllCities, getAttorneysByCity, getCityName } from "../../../utils/attorneys";

export async function getStaticPaths() {
  const cities = getAllCities();
  return cities.map(city => ({ params: { city } }));
}

const { city } = Astro.params;
const attorneys = getAttorneysByCity(city);
const cityName = getCityName(city);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": `Personal Injury Attorneys in ${cityName}, Florida`,
      "numberOfItems": attorneys.length,
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.findpiattorney.com/" },
        { "@type": "ListItem", "position": 2, "name": "Personal Injury Attorneys", "item": "https://www.findpiattorney.com/personal-injury-attorneys/" },
        { "@type": "ListItem", "position": 3, "name": "Florida", "item": "https://www.findpiattorney.com/personal-injury-attorneys/florida" },
        { "@type": "ListItem", "position": 4, "name": cityName, "item": `https://www.findpiattorney.com/personal-injury-attorneys/florida/${city}` }
      ]
    }
  ]
});
---

<BaseLayout
  title={`${cityName} Personal Injury Attorneys | Florida PI Directory`}
  description={`Find ${attorneys.length} personal injury attorneys in ${cityName}, Florida. Browse licensed attorneys for accident and injury cases.`}
  canonical={`https://www.findpiattorney.com/personal-injury-attorneys/florida/${city}`}
  schema={schema}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: "Personal Injury Attorneys", href: "/personal-injury-attorneys" },
          { label: "Florida", href: "/personal-injury-attorneys/florida" },
          { label: cityName, href: `/personal-injury-attorneys/florida/${city}` },
        ]}
      />

      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Personal Injury Attorneys in {cityName}, Florida
      </h1>
      <p class="text-gray-600 mb-8">
        {attorneys.length} {attorneys.length === 1 ? 'attorney' : 'attorneys'} found in {cityName}, FL
      </p>

      <div class="space-y-4">
        {attorneys.map((attorney) => (
          <AttorneyCard attorney={attorney} />
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href="/personal-injury-attorneys/florida" class="inline-flex items-center gap-2 text-brand-700 font-medium hover:text-brand-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Florida Cities
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
