---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import { getAllAttorneys, getCityName } from "../../../../utils/attorneys";

export async function getStaticPaths() {
  const attorneys = getAllAttorneys();
  return attorneys.map(attorney => ({
    params: { city: attorney.city, attorney: attorney.slug },
    props: { attorney }
  }));
}

const { attorney } = Astro.props;
const cityName = getCityName(attorney.city);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LegalService",
      "name": attorney.name,
      "description": attorney.description,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": attorney.address,
        "addressLocality": cityName,
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      ...(attorney.phone && { "telephone": attorney.phone }),
      ...(attorney.email && { "email": attorney.email }),
      ...(attorney.firm && { "parentOrganization": { "@type": "Organization", "name": attorney.firm } })
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.findpiattorney.com/" },
        { "@type": "ListItem", "position": 2, "name": "Personal Injury Attorneys", "item": "https://www.findpiattorney.com/personal-injury-attorneys/" },
        { "@type": "ListItem", "position": 3, "name": "Florida", "item": "https://www.findpiattorney.com/personal-injury-attorneys/florida" },
        { "@type": "ListItem", "position": 4, "name": cityName, "item": `https://www.findpiattorney.com/personal-injury-attorneys/florida/${attorney.city}` },
        { "@type": "ListItem", "position": 5, "name": attorney.name, "item": `https://www.findpiattorney.com/personal-injury-attorneys/florida/${attorney.city}/${attorney.slug}` }
      ]
    }
  ]
});
---

<BaseLayout
  title={`${attorney.name} — Personal Injury Attorney in ${cityName}, FL`}
  description={`${attorney.name}${attorney.firm ? ` at ${attorney.firm}` : ''} is a personal injury attorney in ${cityName}, Florida. Florida Bar #${attorney.barNumber}.`}
  canonical={`https://www.findpiattorney.com/personal-injury-attorneys/florida/${attorney.city}/${attorney.slug}`}
  schema={schema}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: "Personal Injury Attorneys", href: "/personal-injury-attorneys" },
          { label: "Florida", href: "/personal-injury-attorneys/florida" },
          { label: cityName, href: `/personal-injury-attorneys/florida/${attorney.city}` },
          { label: attorney.name, href: `/personal-injury-attorneys/florida/${attorney.city}/${attorney.slug}` },
        ]}
      />

      <div class="max-w-4xl mx-auto">
        <!-- Profile header card -->
        <div class="card p-6 sm:p-8 mb-6">
          <div class="flex flex-col sm:flex-row gap-6 items-start">
            <img
              src={`/avatars/${attorney.slug}.svg`}
              alt={attorney.name}
              class="w-24 h-24 rounded-full flex-shrink-0 mx-auto sm:mx-0"
              width="96" height="96"
            />
            <div class="flex-1 text-center sm:text-left">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1">{attorney.name}</h1>
              {attorney.firm && (
                <p class="text-lg text-brand-700 font-semibold mb-1">{attorney.firm}</p>
              )}
              <p class="text-gray-500 mb-3">Personal Injury Attorney · {cityName}, FL</p>
              {attorney.status && (
                <span class="inline-flex items-center gap-1 bg-green-50 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full border border-green-200">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {attorney.status.split('/')[0].trim()}
                </span>
              )}
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Contact info -->
          <div class="md:col-span-2 space-y-6">
            <div class="card p-6">
              <h2 class="text-lg font-bold text-gray-900 mb-4">Contact Information</h2>
              <dl class="space-y-4">
                {attorney.address && (
                  <div class="flex gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <div>
                      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Address</dt>
                      <dd class="text-gray-800 text-sm">{attorney.address}</dd>
                    </div>
                  </div>
                )}
                {attorney.phone && (
                  <div class="flex gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    <div>
                      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Office Phone</dt>
                      <dd>
                        <a href={`tel:${attorney.phone}`} class="text-brand-700 font-semibold hover:text-brand-900 text-sm">{attorney.phone}</a>
                      </dd>
                    </div>
                  </div>
                )}
                {attorney.otherPhones && (
                  <div class="flex gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    <div>
                      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Other Phones</dt>
                      <dd class="text-gray-700 text-sm">{attorney.otherPhones}</dd>
                    </div>
                  </div>
                )}
                {attorney.email && (
                  <div class="flex gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <div>
                      <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Email</dt>
                      <dd>
                        <a href={`mailto:${attorney.email}`} class="text-brand-700 hover:text-brand-900 text-sm">{attorney.email}</a>
                      </dd>
                    </div>
                  </div>
                )}
              </dl>
            </div>

            <!-- Bar info -->
            <div class="card p-6">
              <h2 class="text-lg font-bold text-gray-900 mb-4">Bar Information</h2>
              <dl class="space-y-3">
                {attorney.barNumber && (
                  <div>
                    <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Florida Bar Number</dt>
                    <dd class="text-gray-800 font-semibold">{attorney.barNumber}</dd>
                  </div>
                )}
                {attorney.status && (
                  <div>
                    <dt class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-0.5">Bar Status</dt>
                    <dd class="text-gray-700 text-sm">{attorney.status}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="space-y-4">
            {attorney.firm && (
              <div class="card p-5">
                <h3 class="text-sm font-bold text-gray-900 mb-2 uppercase tracking-wide">Firm</h3>
                <p class="text-gray-800 font-medium">{attorney.firm}</p>
              </div>
            )}

            <div class="card p-5 bg-brand-50 border-brand-200">
              <h3 class="text-sm font-bold text-brand-900 mb-2 uppercase tracking-wide">Disclaimer</h3>
              <p class="text-xs text-brand-700 leading-relaxed">
                This listing is sourced from public Florida Bar records. Verify credentials directly with
                <a href="https://www.floridabar.org" target="_blank" rel="noopener noreferrer" class="underline">The Florida Bar</a>
                before retaining this attorney.
              </p>
            </div>

            <a
              href={`/personal-injury-attorneys/florida/${attorney.city}`}
              class="card p-4 flex items-center gap-2 text-brand-700 font-medium hover:border-brand-400 transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
              </svg>
              Back to {cityName} Attorneys
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
