---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import USAMapSVG from "../../components/USAMapSVG.astro";
import { getAllCities, getAttorneyCountByCity, getTotalAttorneyCount } from "../../utils/attorneys";

const cities = getAllCities();
const totalAttorneys = getTotalAttorneyCount();

const activeStates = [{
  slug: "florida",
  name: "Florida",
  count: totalAttorneys,
}];
---

<BaseLayout
  title="Personal Injury Attorneys Directory — Find Licensed PI Attorneys in Florida"
  description="Find licensed personal injury attorneys across Florida. Trusted by accident victims and families for representation in injury and negligence cases."
  canonical="https://www.findpiattorney.com/personal-injury-attorneys/"
>
  <Header />

  <main class="flex-1">
    <!-- Hero -->
    <section class="relative bg-brand-900 text-white overflow-hidden">
      <div class="relative page-container py-14 text-center">
        <div class="inline-flex items-center gap-2 bg-white/10 text-white text-xs font-semibold px-3 py-1.5 rounded-full mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
          </svg>
          Florida PI Attorney Directory
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
          Personal Injury Attorneys Directory
        </h1>
        <p class="mt-4 text-lg text-brand-200 max-w-2xl mx-auto">
          The directory dedicated to licensed personal injury attorneys in Florida.
          Browse by city to find an experienced attorney for your accident or injury case.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-8 text-center">
          <div>
            <div class="text-3xl font-bold">{totalAttorneys.toLocaleString()}</div>
            <div class="text-brand-200 text-sm">Attorneys Listed</div>
          </div>
          <div class="border-l border-white/20 pl-8">
            <div class="text-3xl font-bold">{cities.length}</div>
            <div class="text-brand-200 text-sm">Florida Cities</div>
          </div>
          <div class="border-l border-white/20 pl-8">
            <div class="text-3xl font-bold">FL Bar</div>
            <div class="text-brand-200 text-sm">Licensed Attorneys</div>
          </div>
          <div class="border-l border-white/20 pl-8">
            <div class="text-3xl font-bold">Free</div>
            <div class="text-brand-200 text-sm">Directory Access</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why section -->
    <section class="page-container section-padding">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start mb-12">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Why Hire a Personal Injury Attorney?</h2>
          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p>Personal injury attorneys work on contingency — meaning they only get paid if you win. They handle all negotiations with insurance companies, gather evidence, and build your case so you can focus on recovery.</p>
            <p>An experienced PI attorney knows how to maximize your settlement and will fight for compensation that covers not just immediate medical costs, but future care needs and lost earning capacity.</p>
          </div>
          <ul class="mt-5 space-y-2 text-sm text-gray-700">
            {[
              "Negotiate directly with insurance companies on your behalf",
              "Gather police reports, medical records, and witness statements",
              "Calculate the true value of your claim including future damages",
              "Represent you in court if a fair settlement can't be reached",
              "Work on contingency — no upfront fees",
            ].map(item => (
              <li class="flex items-start gap-2">
                <span class="mt-1 w-1.5 h-1.5 rounded-full bg-brand-500 flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-brand-50 border border-brand-100 rounded-xl p-6">
          <h3 class="text-lg font-bold text-brand-900 mb-3">Common Case Types</h3>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">
            Florida personal injury attorneys handle a wide range of accident and negligence cases. Browse our directory to find attorneys experienced in your type of case.
          </p>
          <div class="bg-white rounded-lg p-4 border border-brand-200">
            <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Practice Areas</p>
            <ul class="text-sm text-gray-700 space-y-1">
              <li>Motor vehicle accidents</li>
              <li>Slip and fall / premises liability</li>
              <li>Medical malpractice</li>
              <li>Wrongful death</li>
              <li>Workers' compensation</li>
              <li>Product liability</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Map -->
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Browse by State</h2>
      <p class="text-gray-600 mb-6">Click Florida to browse Personal Injury Attorneys in your area.</p>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-4">
        <USAMapSVG
          activeStates={activeStates}
          basePath="/personal-injury-attorneys"
          tooltipLabel="Attorneys"
        />
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
