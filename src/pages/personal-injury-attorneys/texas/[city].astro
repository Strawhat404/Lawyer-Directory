---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import AttorneyCard from "../../../components/AttorneyCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getCitiesByState, getAttorneysByStateAndCity, getCityName } from "../../../utils/attorneys";

const ITEMS_PER_PAGE = 20;

export async function getStaticPaths() {
  const cities = getCitiesByState("texas");
  return cities.map(city => ({ params: { city } }));
}

const { city } = Astro.params;
const allAttorneys = getAttorneysByStateAndCity("texas", city);
const cityName = getCityName(city);

const totalPages = Math.ceil(allAttorneys.length / ITEMS_PER_PAGE);
const attorneys = allAttorneys.slice(0, ITEMS_PER_PAGE);
const baseUrl = `/personal-injury-attorneys/texas/${city}`;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": `Personal Injury Attorneys in ${cityName}, Texas`,
      "numberOfItems": allAttorneys.length,
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.findpiattorney.com/" },
        { "@type": "ListItem", "position": 2, "name": "Personal Injury Attorneys", "item": "https://www.findpiattorney.com/personal-injury-attorneys/" },
        { "@type": "ListItem", "position": 3, "name": "Texas", "item": "https://www.findpiattorney.com/personal-injury-attorneys/texas" },
        { "@type": "ListItem", "position": 4, "name": cityName, "item": `https://www.findpiattorney.com/personal-injury-attorneys/texas/${city}` }
      ]
    }
  ]
});
---

<BaseLayout
  title={`${cityName} Personal Injury Attorneys | Texas PI Directory`}
  description={`Find ${allAttorneys.length} personal injury attorneys in ${cityName}, Texas. Browse licensed attorneys for accident and injury cases.`}
  canonical={`https://www.findpiattorney.com/personal-injury-attorneys/texas/${city}`}
  schema={schema}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: "Personal Injury Attorneys", href: "/personal-injury-attorneys" },
          { label: "Texas", href: "/personal-injury-attorneys/texas" },
          { label: cityName, href: `/personal-injury-attorneys/texas/${city}` },
        ]}
      />

      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Personal Injury Attorneys in {cityName}, Texas
      </h1>
      <p class="text-gray-600 mb-8">
        {allAttorneys.length} {allAttorneys.length === 1 ? 'attorney' : 'attorneys'} found in {cityName}, TX
        {totalPages > 1 && <span class="text-gray-400"> - Page 1 of {totalPages}</span>}
      </p>

      <div class="space-y-4">
        {attorneys.map((attorney) => (
          <AttorneyCard attorney={attorney} />
        ))}
      </div>

      <Pagination currentPage={1} totalPages={totalPages} baseUrl={baseUrl} />

      <div class="mt-8 text-center">
        <a href="/personal-injury-attorneys/texas" class="inline-flex items-center gap-2 text-brand-700 font-medium hover:text-brand-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to Texas Cities
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
