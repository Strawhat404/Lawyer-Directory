---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Header from "../../../../../components/Header.astro";
import Footer from "../../../../../components/Footer.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";
import AttorneyCard from "../../../../../components/AttorneyCard.astro";
import Pagination from "../../../../../components/Pagination.astro";
import { getCitiesByState, getAttorneysByStateAndCity, getCityName } from "../../../../../utils/attorneys";

const ITEMS_PER_PAGE = 20;

export async function getStaticPaths() {
  const ITEMS_PER_PAGE = 20;
  const cities = getCitiesByState("new-jersey");
  const paths: { params: { city: string; page: string }; props: { totalCount: number } }[] = [];

  for (const city of cities) {
    const attorneys = getAttorneysByStateAndCity("new-jersey", city);
    const totalPages = Math.ceil(attorneys.length / ITEMS_PER_PAGE);
    for (let p = 2; p <= totalPages; p++) {
      paths.push({
        params: { city, page: String(p) },
        props: { totalCount: attorneys.length },
      });
    }
  }
  return paths;
}

const { city, page } = Astro.params;
const { totalCount } = Astro.props;
const currentPage = Number(page);
const cityName = getCityName(city);

const allAttorneys = getAttorneysByStateAndCity("new-jersey", city);
const totalPages = Math.ceil(allAttorneys.length / ITEMS_PER_PAGE);
const attorneys = allAttorneys.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);
const baseUrl = `/personal-injury-attorneys/new-jersey/${city}`;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "name": `Personal Injury Attorneys in ${cityName}, New Jersey - Page ${currentPage}`,
      "numberOfItems": totalCount,
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.findpiattorney.com/" },
        { "@type": "ListItem", "position": 2, "name": "Personal Injury Attorneys", "item": "https://www.findpiattorney.com/personal-injury-attorneys/" },
        { "@type": "ListItem", "position": 3, "name": "New Jersey", "item": "https://www.findpiattorney.com/personal-injury-attorneys/new-jersey" },
        { "@type": "ListItem", "position": 4, "name": cityName, "item": `https://www.findpiattorney.com/personal-injury-attorneys/new-jersey/${city}` }
      ]
    }
  ]
});
---

<BaseLayout
  title={`${cityName} Personal Injury Attorneys - Page ${currentPage} | New Jersey PI Directory`}
  description={`Page ${currentPage} of ${totalPages} - Browse personal injury attorneys in ${cityName}, New Jersey.`}
  canonical={`https://www.findpiattorney.com/personal-injury-attorneys/new-jersey/${city}/page/${currentPage}`}
  schema={schema}
>
  <Header />

  <main class="flex-1">
    <div class="page-container section-padding">
      <Breadcrumb
        links={[
          { label: "Home", href: "/" },
          { label: "Personal Injury Attorneys", href: "/personal-injury-attorneys" },
          { label: "New Jersey", href: "/personal-injury-attorneys/new-jersey" },
          { label: cityName, href: `/personal-injury-attorneys/new-jersey/${city}` },
          { label: `Page ${currentPage}`, href: `/personal-injury-attorneys/new-jersey/${city}/page/${currentPage}` },
        ]}
      />

      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        Personal Injury Attorneys in {cityName}, New Jersey
      </h1>
      <p class="text-gray-600 mb-8">
        {totalCount} {totalCount === 1 ? 'attorney' : 'attorneys'} found in {cityName}, NJ
        <span class="text-gray-400"> - Page {currentPage} of {totalPages}</span>
      </p>

      <div class="space-y-4">
        {attorneys.map((attorney) => (
          <AttorneyCard attorney={attorney} />
        ))}
      </div>

      <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={baseUrl} />

      <div class="mt-8 text-center">
        <a href="/personal-injury-attorneys/new-jersey" class="inline-flex items-center gap-2 text-brand-700 font-medium hover:text-brand-900 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
          Back to New Jersey Cities
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
