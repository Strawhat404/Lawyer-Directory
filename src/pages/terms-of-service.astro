---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Terms of Service | Personal Injury Attorney Directory"
  description="Terms of service for the Personal Injury Attorney Directory."
  canonical="https://www.findpiattorney.com/terms-of-service"
>
  <Header />
  <main class="flex-1">
    <section class="section-padding">
      <div class="page-container">
        <div class="max-w-3xl mx-auto prose prose-lg">
          <h1>Terms of Service</h1>
          
          <p><strong>Last Updated:</strong> August 15, 2026</p>

          <h2>Acceptance of Terms</h2>
          <p>
            By accessing and using this website, you accept and agree to be bound by the terms and conditions of this agreement.
          </p>

          <h2>Description of Service</h2>
          <p>
            Personal Injury Attorney Directory is an informational directory website that provides public information about attorneys licensed to practice in Florida. This is not a referral service, and we do not endorse or recommend any particular attorney.
          </p>

          <h2>No Legal Advice</h2>
          <p>
            The information on this website is for general informational purposes only and does not constitute legal advice. You should consult with a qualified attorney for advice specific to your situation.
          </p>

          <h2>Attorney Information</h2>
          <p>
            Attorney listings are compiled from public records. We make efforts to ensure accuracy but cannot guarantee that all information is current or complete. Users should verify attorney credentials directly with The Florida Bar before retaining an attorney.
          </p>

          <h2>Limitation of Liability</h2>
          <p>
            We are not responsible for any errors, omissions, or inaccuracies in the attorney information displayed. We are not liable for any outcomes resulting from contact with or retention of attorneys listed on this site.
          </p>

          <h2>Changes to Terms</h2>
          <p>
            We reserve the right to modify these terms at any time. Continued use of the website after changes constitutes acceptance of the modified terms.
          </p>

          <h2>Contact</h2>
          <p>
            Questions about these terms should be directed to:
            <a href="mailto:info@findpiattorney.com">info@findpiattorney.com</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
