---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": "What is Personal Injury Law?",
      "description": "A guide to personal injury law — case types, the claims process, damages, and how to protect your rights after an accident.",
      "datePublished": "2026-08-15",
      "dateModified": "2026-08-16",
      "author": { "@type": "Organization", "name": "Personal Injury Attorney Directory" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the statute of limitations for personal injury in Florida?",
          "acceptedAnswer": { "@type": "Answer", "text": "2 years from the date of injury as of the 2023 reform. Missing this deadline typically bars recovery entirely." }
        },
        {
          "@type": "Question",
          "name": "What damages can I recover in a personal injury case?",
          "acceptedAnswer": { "@type": "Answer", "text": "You may recover economic damages (medical bills, lost wages) and non-economic damages (pain and suffering, emotional distress). Punitive damages may apply in cases of egregious conduct." }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.findpiattorney.com/" },
        { "@type": "ListItem", "position": 2, "name": "What is Personal Injury Law", "item": "https://www.findpiattorney.com/what-is-personal-injury-law/" }
      ]
    }
  ]
});
---

<BaseLayout
  title="What is Personal Injury Law? | PI Attorney Directory"
  description="A complete guide to personal injury law — case types, how claims work, what compensation you can recover, and critical deadlines to know."
  canonical="https://www.findpiattorney.com/what-is-personal-injury-law/"
  schema={schema}
>
  <Header />
  <main class="flex-1">

    <!-- Hero -->
    <section class="bg-brand-900 text-white">
      <div class="page-container py-12">
        <h1 class="text-3xl sm:text-4xl font-bold">What is Personal Injury Law?</h1>
        <p class="text-xs text-gray-400 mt-2 mb-1">Updated: August 2026</p>
        <p class="mt-3 text-brand-200 max-w-2xl">A plain-language overview of personal injury law — what it covers, how claims work, and what compensation you can seek.</p>
      </div>
    </section>

    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto space-y-10">

        <!-- Hero image -->
        <div class="rounded-2xl overflow-hidden shadow-md">
          <img
            src="/images/law-books.webp"
            alt="Law books representing personal injury law statutes and case law"
            class="w-full max-h-72 object-cover"
            loading="lazy"
            width="900"
            height="400"
          />
        </div>

        <!-- Disclaimer -->
        <div class="p-4 bg-amber-50 border-l-4 border-amber-400 rounded-r-xl text-sm text-gray-700">
          <p class="font-bold text-amber-900 mb-1">Educational Information Only</p>
          <p>This page provides general educational information. It is not legal advice. Consult a licensed attorney for guidance on your specific situation.</p>
        </div>

        <!-- Intro -->
        <p class="text-lg text-gray-600 leading-relaxed">
          Personal injury law — also called <strong>tort law</strong> — gives injured individuals the legal right to seek financial compensation when someone else's negligence, recklessness, or intentional wrongdoing caused them harm. It is one of the most important areas of civil law, touching everything from car accidents to medical mistakes.
        </p>

        <!-- Section 1 -->
        <div>
          <h2 class="text-2xl font-bold text-brand-900 mb-4">What Does Personal Injury Law Cover?</h2>
          <p class="text-gray-700 mb-4">Personal injury law covers any situation where someone suffers physical, psychological, or financial harm due to another party's wrongful conduct. Common case types include:</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {[
              ["Motor vehicle accidents", "Car, truck, motorcycle, bicycle, and pedestrian collisions"],
              ["Slip and fall accidents", "Injuries on someone else's property due to hazardous conditions"],
              ["Medical malpractice", "Harm from negligent diagnosis, treatment, or surgical errors"],
              ["Product liability", "Injuries caused by defective or dangerous products"],
              ["Wrongful death", "Death caused by another's negligence or intentional act"],
              ["Workers' compensation", "Workplace injuries and occupational diseases"],
              ["Dog bites", "Strict owner liability in most circumstances"],
              ["Nursing home abuse", "Harm to residents of long-term care facilities"],
            ].map(([title, desc]) => (
              <div class="bg-white border border-gray-200 rounded-xl p-4 hover:border-brand-400 transition-colors">
                <p class="font-bold text-gray-900 text-sm mb-1">{title}</p>
                <p class="text-xs text-gray-600">{desc}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Section 2: No-fault -->
        <div class="bg-brand-50 border border-brand-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-brand-900 mb-3">Florida's No-Fault Auto Insurance System</h2>
          <p class="text-gray-700 mb-3">Florida is a <strong>no-fault state</strong> for auto accidents. Your own Personal Injury Protection (PIP) insurance covers initial medical bills and lost wages — regardless of who caused the crash.</p>
          <p class="text-gray-700">However, you can step outside the no-fault system and sue the at-fault driver when injuries are <strong>serious or permanent</strong>: significant loss of a bodily function, permanent injury, significant scarring, or death. For serious injuries, a PI attorney is essential.</p>
        </div>

        <!-- Section 3: How claims work -->
        <div>
          <h2 class="text-2xl font-bold text-brand-900 mb-4">How a Personal Injury Claim Works</h2>
          <div class="space-y-3">
            {[
              ["1", "You are injured due to someone else's negligence"],
              ["2", "Seek immediate medical treatment and document everything"],
              ["3", "Consult a PI attorney — most offer free initial consultations"],
              ["4", "Attorney investigates, gathers evidence, and identifies liable parties"],
              ["5", "Demand letter sent to the at-fault party's insurer"],
              ["6", "Negotiations begin — most cases settle without going to trial"],
              ["7", "If settlement is inadequate, attorney files suit and litigates"],
            ].map(([num, step]) => (
              <div class="flex items-start gap-4 bg-white border border-gray-200 rounded-xl p-4">
                <span class="w-8 h-8 rounded-full bg-brand-700 text-white text-sm font-bold flex items-center justify-center flex-shrink-0">{num}</span>
                <p class="text-gray-800 text-sm leading-relaxed pt-1">{step}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Section 4: Statute of limitations -->
        <div class="bg-red-50 border border-red-200 rounded-2xl p-6">
          <h2 class="text-2xl font-bold text-red-900 mb-3">Critical Deadlines — Statute of Limitations</h2>
          <p class="text-gray-700 mb-4">Missing the statute of limitations deadline means your claim is permanently barred in most cases. Key deadlines:</p>
          <div class="space-y-2">
            {[
              ["General personal injury", "2 years from date of injury (Florida 2023 reform)"],
              ["Medical malpractice", "2 years from discovery, max 4 years from the act"],
              ["Wrongful death", "2 years from date of death"],
              ["Claims vs. government", "Strict notice requirements — consult an attorney immediately"],
            ].map(([type, deadline]) => (
              <div class="flex justify-between items-center bg-white border border-red-100 rounded-lg px-4 py-3">
                <span class="text-sm font-semibold text-gray-900">{type}</span>
                <span class="text-sm text-red-700 font-medium">{deadline}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Section 5: Damages -->
        <div>
          <h2 class="text-2xl font-bold text-brand-900 mb-4">What Compensation Can You Recover?</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-white border border-gray-200 rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-3 text-base border-b pb-2">Economic Damages</h3>
              <ul class="space-y-1.5 text-sm text-gray-700">
                <li>Past and future medical expenses</li>
                <li>Lost wages</li>
                <li>Loss of future earning capacity</li>
                <li>Property damage</li>
                <li>Out-of-pocket related expenses</li>
              </ul>
            </div>
            <div class="bg-white border border-gray-200 rounded-2xl p-5">
              <h3 class="font-bold text-gray-900 mb-3 text-base border-b pb-2">Non-Economic Damages</h3>
              <ul class="space-y-1.5 text-sm text-gray-700">
                <li>Pain and suffering</li>
                <li>Emotional distress</li>
                <li>Loss of enjoyment of life</li>
                <li>Disfigurement or permanent disability</li>
                <li>Loss of consortium</li>
              </ul>
            </div>
          </div>
          <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-700">
            <strong>Note:</strong> Florida's modified comparative negligence law (2023) reduces your recovery by your percentage of fault. If you are more than 50% at fault, you are barred from recovery entirely.
          </div>
        </div>

        <!-- CTA -->
        <div class="p-6 bg-brand-50 border border-brand-200 rounded-2xl text-center">
          <h3 class="text-lg font-bold text-brand-900 mb-2">Find a Personal Injury Attorney</h3>
          <p class="text-gray-700 mb-4 text-sm">Browse licensed attorneys by state and city — bar number and contact info included.</p>
          <a href="/personal-injury-attorneys/florida" class="btn-primary text-sm">Browse Attorneys</a>
        </div>

      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
