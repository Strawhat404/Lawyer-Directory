---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Advertising Disclosure | PI Attorney Directory" description="Advertising disclosure for the Personal Injury Attorney Directory." canonical="https://www.findpiattorney.com/advertising-disclosure/">
  <Header />
  <main class="flex-1">
    <div class="page-container section-padding">
      <div class="max-w-3xl mx-auto prose prose-gray">
        <h1>Advertising Disclosure</h1>
        <p>This website is an advertising and information service. Some listings may be paid placements. Paid listings are labeled "Sponsored" where applicable.</p>
        <p>Inclusion in this directory does not constitute an endorsement or recommendation of any attorney. Users should independently verify credentials with The Florida Bar before retaining any attorney.</p>
        <p>For questions about advertising or listings, contact us at <a href="mailto:info@findpiattorney.com">info@findpiattorney.com</a>.</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
