---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import USAMapSVG from "../components/USAMapSVG.astro";
import { getAllCities, getTotalAttorneyCount, getAttorneyCountByState } from "../utils/attorneys";

const cities = getAllCities();
const totalAttorneys = getTotalAttorneyCount();

const activeStates = [
  {
    slug: "florida",
    name: "Florida",
    count: getAttorneyCountByState("florida"),
  },
  {
    slug: "new-jersey",
    name: "New Jersey",
    count: getAttorneyCountByState("new-jersey"),
  },
  {
    slug: "texas",
    name: "Texas",
    count: getAttorneyCountByState("texas"),
  },
  {
    slug: "new-york",
    name: "New York",
    count: getAttorneyCountByState("new-york"),
  },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.findpiattorney.com/#organization",
      "name": "Personal Injury Attorney Directory",
      "url": "https://www.findpiattorney.com/",
      "logo": "https://www.findpiattorney.com/favicon.svg",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "info@findpiattorney.com",
        "availableLanguage": "English"
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.findpiattorney.com/#website",
      "url": "https://www.findpiattorney.com/",
      "name": "Personal Injury Attorney Directory",
      "publisher": { "@id": "https://www.findpiattorney.com/#organization" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a personal injury attorney?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A personal injury attorney is a licensed lawyer who represents people injured due to the negligence or wrongdoing of others. They help clients seek compensation for medical expenses, lost wages, pain and suffering, and other damages."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a personal injury attorney cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Contingency fee percentages are subject to individual attorney representation agreements. Depending on state rules and contract terms, clients may remain responsible for court costs and case expenses regardless of legal outcome."
          }
        },
        {
          "@type": "Question",
          "name": "What is the statute of limitations for personal injury in Florida?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In Florida, most personal injury claims must be filed within 2 years of the date of injury. Missing this deadline can permanently bar recovery."
          }
        }
      ]
    }
  ]
});
---

<BaseLayout
  title="Personal Injury Attorney Directory | Find Licensed PI Lawyers Nationwide"
  description="Browse licensed personal injury attorneys across the United States. Currently active in Florida, New Jersey, and Texas — expanding nationwide. Find experienced PI lawyers by state and city."
  canonical="https://www.findpiattorney.com/"
  schema={schema}
>
  <Header />

  <main class="flex-1">

    <!-- Hero -->
    <section class="relative bg-brand-900 text-white overflow-hidden">
      <img
        src="/images/legal-banner.webp"
        alt="Abstract legal pattern with scales of justice, courthouse columns, and law books"
        class="absolute inset-0 w-full h-full object-cover object-center"
        fetchpriority="high"
        loading="eager"
        width="1024"
        height="1024"
      />
      <div class="absolute inset-0 bg-brand-900/80"></div>
      <div class="relative page-container section-padding text-center">
        <div class="inline-flex items-center gap-2 bg-white/10 text-white text-xs font-semibold px-3 py-1.5 rounded-full mb-5 border border-white/20">
          Nationwide PI Attorney Directory - Active in Florida, New Jersey & Texas
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight max-w-4xl mx-auto">
          Find a Personal Injury Attorney Near You
        </h1>
        <p class="mt-5 text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
          Browse {totalAttorneys.toLocaleString()} licensed attorneys across the United States. Currently covering {cities.length} cities across Florida, New Jersey, and Texas - expanding to all 50 states.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/personal-injury-attorneys" class="btn-primary !bg-white !text-brand-900 hover:!bg-brand-100 text-base font-bold">Browse Attorneys Now</a>
          <a href="/what-is-personal-injury-law" class="btn-primary !bg-transparent !border-2 !border-white hover:!bg-white/10 text-base">What is Personal Injury Law?</a>
        </div>
      </div>
    </section>

    <!-- What we do / who needs us -->
    <section class="page-container section-padding">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Card 1 -->
        <div class="rounded-2xl overflow-hidden border border-brand-100 bg-brand-50">
          <img
            src="/images/attorney-desk.webp"
            alt="Personal injury attorney reviewing case documents at desk"
            class="w-full aspect-video object-cover"
            loading="lazy"
            width="700"
            height="394"
          />
          <div class="p-6">
            <h2 class="text-xl font-bold text-brand-900 mb-3">What is a Personal Injury Attorney?</h2>
            <p class="text-gray-700 leading-relaxed mb-3">
              A personal injury attorney is a licensed lawyer who represents individuals physically or psychologically harmed through another party's negligence, recklessness, or intentional misconduct.
            </p>
            <p class="text-gray-700 leading-relaxed">
              Attorneys assist with key aspects of your case, including evidence gathering, insurance communications, and settlement negotiations.
            </p>
            <a href="/what-is-personal-injury-law" class="inline-block mt-4 text-brand-700 font-semibold hover:text-brand-900 transition-colors">
              Learn about personal injury law →
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm">
          <img
            src="/images/attorney-handshake.webp"
            alt="Attorney and client shaking hands after agreeing to representation"
            class="w-full aspect-video object-cover"
            loading="lazy"
            width="700"
            height="394"
          />
          <div class="p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Who Needs a Personal Injury Attorney?</h2>
            <ul class="space-y-2.5 text-gray-700">
              {[
                ["Car accident victims", "seeking compensation for injuries, vehicle damage, and lost wages"],
                ["Slip and fall victims", "injured on someone else's property due to negligence"],
                ["Families", "pursuing wrongful death claims after losing a loved one"],
                ["Workers", "injured on the job who need guidance beyond workers' comp"],
                ["Medical malpractice victims", "harmed by negligent healthcare providers"],
              ].map(([bold, rest]) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-brand-500 flex-shrink-0"></span>
                  <span><strong>{bold}</strong> {rest}</span>
                </li>
              ))}
            </ul>
            <a href="/how-to-choose-a-pi-attorney" class="inline-block mt-4 text-brand-700 font-semibold hover:text-brand-900 transition-colors">
              How to choose the right attorney →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Map section -->
    <section class="bg-gray-50">
      <div class="page-container section-padding">
        <div class="text-center mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Browse Attorneys by State</h2>
          <p class="text-gray-600 max-w-xl mx-auto">Click an active state to browse attorneys. Hover any state to see availability - grey states are coming soon.</p>
        </div>

        <!-- Stats bar -->
        <div class="bg-brand-900 rounded-2xl p-6 mb-6 text-white">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center divide-x divide-white/10">
            <div class="px-4">
              <div class="text-3xl font-bold">{totalAttorneys.toLocaleString()}</div>
              <div class="text-brand-200 text-sm mt-1">Attorneys Listed</div>
            </div>
            <div class="px-4">
              <div class="text-3xl font-bold">{cities.length}</div>
              <div class="text-brand-200 text-sm mt-1">Cities Active</div>
            </div>
            <div class="px-4">
              <div class="text-3xl font-bold">50</div>
              <div class="text-brand-200 text-sm mt-1">States - Expanding</div>
            </div>
            <div class="px-4">
              <div class="text-3xl font-bold">Free</div>
              <div class="text-brand-200 text-sm mt-1">Directory Access</div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-4">
          <USAMapSVG
            activeStates={activeStates}
            basePath="/personal-injury-attorneys"
            tooltipLabel="Attorneys"
          />
        </div>
      </div>
    </section>

    <!-- Why use our directory - 3 cards -->
    <section class="bg-white">
      <div class="page-container section-padding">
        <div class="text-center mb-10">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Why Use This Directory?</h2>
          <p class="text-gray-600 mt-2 max-w-xl mx-auto">A straightforward, no-nonsense way to find a licensed personal injury attorney.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="rounded-2xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
            <img src="/images/law-books.webp" alt="Law books representing legal expertise" class="w-full aspect-video object-cover" loading="lazy" width="400" height="225"/>
            <div class="p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-lg">Bar-Licensed Only</h3>
              <p class="text-sm text-gray-600 leading-relaxed">All listings are sourced directly from public state bar records. Only licensed, active attorneys appear in this directory.</p>
            </div>
          </div>

          <div class="rounded-2xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
            <img src="/images/courtroom.webp" alt="Courtroom representing litigation and legal proceedings" class="w-full aspect-video object-cover" loading="lazy" width="400" height="225"/>
            <div class="p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-lg">Free to Browse</h3>
              <p class="text-sm text-gray-600 leading-relaxed">This directory is completely free to use. We charge no fees, take no referral cuts, and have no financial relationship with any listed attorney.</p>
            </div>
          </div>

          <div class="rounded-2xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
            <img src="/images/accident-scene.webp" alt="Scene representing personal injury accident" class="w-full aspect-video object-cover" loading="lazy" width="400" height="225"/>
            <div class="p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-lg">Expanding Nationwide</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Currently active in Florida, New Jersey, and Texas — expanding nationwide. Hover any state on the map to see its status.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Section (Coming Soon) -->
    <section class="bg-brand-900 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[url('/images/legal-banner.webp')] bg-cover bg-center"></div>
      <div class="page-container section-padding relative z-10 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold mb-4">Legal Guides & Educational Resources</h2>
        <p class="text-brand-200 mb-8 max-w-2xl mx-auto">General information on personal injury claims and attorney selection.</p>
        
        <div class="max-w-4xl mx-auto aspect-video bg-black/40 rounded-2xl border border-white/10 flex flex-col items-center justify-center backdrop-blur-sm relative group overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          <div class="relative z-10 flex flex-col items-center p-6">
            <div class="w-16 h-16 bg-white/10 rounded-full flex items-center justify-center mb-4 border border-white/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-300" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Video Library Coming Soon</h3>
            <p class="text-sm text-gray-300 max-w-md text-center">We are currently producing a series of high-quality educational videos to help you navigate your personal injury claim.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-gray-50">
      <div class="page-container section-padding">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-8 text-center">Common Questions</h2>
          <div class="space-y-4">
            {[
              {
                q: "How much does a personal injury attorney cost?",
                a: "Contingency fee percentages are subject to individual attorney representation agreements. Depending on state rules and contract terms, clients may remain responsible for court costs and case expenses regardless of legal outcome."
              },
              {
                q: "What is Florida's statute of limitations for personal injury?",
                a: "Florida's statute of limitations for most personal injury claims is 2 years from the date of injury (2023 reform). Missing this deadline typically bars recovery entirely. Consult an attorney promptly - evidence disappears and witnesses' memories fade."
              },
              {
                q: "Which states are currently covered in this directory?",
                a: "Currently active in Florida, New Jersey, and Texas — expanding nationwide. Hover over any state on the map to see its status."
              },
              {
                q: "Are the attorneys in this directory recommended or endorsed?",
                a: "No. This is an informational directory sourced from public bar records. Inclusion does not constitute an endorsement or recommendation. Always verify credentials and conduct your own due diligence before retaining any attorney."
              }
            ].map(({ q, a }) => (
              <div class="bg-white rounded-2xl border border-gray-200 p-6">
                <h3 class="font-bold text-gray-900 mb-2">{q}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{a}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="bg-amber-50 border-t border-amber-200">
      <div class="page-container py-6">
        <p class="text-xs text-amber-900 text-center leading-relaxed max-w-4xl mx-auto">
          <strong>Educational Information Only.</strong> This directory is an informational service. Nothing on this website constitutes legal advice. Attorney listings are sourced from public bar records and do not constitute an endorsement. Always verify credentials with your state bar before retaining any attorney.
        </p>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
